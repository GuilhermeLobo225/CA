# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Model weights
# Large .pt / .pth files do not fit in git (RoBERTa ~500 MB, wav2vec2 ~1.2 GB).
# Share them via OneDrive/Drive between teammates.
*.pt
*.pth
# Note: small .pkl files in checkpoints/ (meta-classifiers, 2-51 KB)
# are intentionally tracked - they're enough to run the handover simulation
# with the pre-computed feature CSVs.

# Model caches (downloaded at runtime)
tmp_speechbrain/
.cache/

# Data files (downloaded via HuggingFace)
data/raw/
data/processed/*.png

# MELD audio cache (HF dataset materialised on disk for wav2vec2 fine-tune)
# ~1.3 GB. Regenerable from load_meld_audio_records() in train_audio.py
data/cache/

# Synthetic data (generated locally, large + costs API credits to regenerate)
data/synthetic/audio/
data/synthetic/*.wav
data/synthetic/*.jsonl
data/synthetic/manifest.csv
data/synthetic/text_judged.jsonl
data/synthetic/validation_*

# API keys / secrets - never commit
.env
.env.local
.env.*.local
!.env.example
configs/iaedu_accounts.json
!configs/iaedu_accounts.example.json

# Claude Code local settings (per-user, not for git)
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
